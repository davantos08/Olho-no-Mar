        <pre id="espCodeBox" class="mono" style="color:#7dd3fc;">// Base Receptora LoRa 915MHz -> Envia Alerta SOS direto para Central
#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;

const char* SUPABASE_URL = "https://SEU-PROJETO.supabase.co/rest/v1/alertas";
const char* SUPABASE_KEY = "SUA_ANON_KEY";

void enviarAlertaCentral(String postoNome, String agenteNome, float lat, float lng) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(SUPABASE_URL);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("apikey", SUPABASE_KEY);
    http.addHeader("Authorization", String("Bearer ") + SUPABASE_KEY);

    String payload = "{\"posto_nome\":\"" + postoNome +
                     "\",\"agente_nome\":\"" + agenteNome +
                     "\",\"natureza\":\"Botao Fisico LoRa SOS\"" +
                     ",\"lat\":" + String(lat, 6) +
                     ",\"lng\":" + String(lng, 6) + "}";
    http.POST(payload);
    http.end();
  }
}</pre>
