  <script>
    const STORAGE_KEY = 'olho_no_mar_prod_state';
    const SESSION_KEY = 'olho_no_mar_active_session';
    const CLOUD_CFG_KEY = 'olho_no_mar_cloud_cfg';
    let supabaseClient = null;
    let supabaseAdminAux = null;
    let currentUser = null;
    let currentShift = null;
    let selectedNature = 'Afogamento / Resgate';
    let deviceGps = null;

    let map = null;
    let mapMarkersLayer = null;
    let audioCtx = null;
    let sirenInterval = null;

    const initialProdState = {
      users: [
        { id: 'u-central-master', nome: 'Central de Comando', matricula: 'CENT-01', email: 'central@olhonomar.gov.br', senha: '123456', role: 'central', ativo: true }
      ],
      postos: [
        { id: 'p-01', nome: 'Posto 01 - Pina', lat: -8.09540, lng: -34.88210, ativo: true },
        { id: 'p-02', nome: 'Posto 02 - Segundo Jardim', lat: -8.10890, lng: -34.88950, ativo: true },
        { id: 'p-03', nome: 'Posto 03 - Acaiaca', lat: -8.11940, lng: -34.89420, ativo: true },
        { id: 'p-04', nome: 'Posto 04 - Parque Dona Lindu', lat: -8.13380, lng: -34.90080, ativo: true }
      ],
      turnos_ativos: [],
      alertas: []
    };

    function getState() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(initialProdState));
        return JSON.parse(JSON.stringify(initialProdState));
      }
      return JSON.parse(raw);
    }

    function setState(newState) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(newState));
      syncUiAll();
    }

    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_KEY) syncUiAll();
    });

    function initCloud() {
      const cfg = JSON.parse(localStorage.getItem(CLOUD_CFG_KEY) || 'null');
      const badge = document.getElementById('cloudStatusBadge');
      if (cfg && cfg.url && cfg.key && window.supabase) {
        supabaseClient = window.supabase.createClient(cfg.url, cfg.key);
        supabaseAdminAux = window.supabase.createClient(cfg.url, cfg.key, {
          auth: { persistSession: false, autoRefreshToken: false }
        });
        badge.className = 'status-pill connected';
        badge.innerHTML = '<span>Servidor em Nuvem Conectado</span><button onclick="openCloudModal()">Alterar</button>';
        subscribeRealtimeSupabase();
      } else {
        supabaseClient = null;
        badge.className = 'status-pill';
        badge.innerHTML = '<span>Banco Local Ativo</span><button onclick="openCloudModal()">Conectar Servidor</button>';
      }
    }

    function subscribeRealtimeSupabase() {
      if (!supabaseClient) return;
      supabaseClient.channel('olho-no-mar-prod-rt')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'alertas' }, () => pullFromSupabase())
        .on('postgres_changes', { event: '*', schema: 'public', table: 'postos' }, () => pullFromSupabase())
        .on('postgres_changes', { event: '*', schema: 'public', table: 'turnos_ativos' }, () => pullFromSupabase())
        .subscribe();
    }

    async function pullFromSupabase() {
      if (!supabaseClient) return;
      const [uRes, pRes, tRes, aRes] = await Promise.all([
        supabaseClient.from('perfis').select('*'),
        supabaseClient.from('postos').select('*').order('nome'),
        supabaseClient.from('turnos_ativos').select('*'),
        supabaseClient.from('alertas').select('*').order('criado_em', { ascending: false }).limit(50)
      ]);
      const st = getState();
      if (uRes.data) st.users = uRes.data.map(u => ({ ...u, senha: '••••••' }));
      if (pRes.data) st.postos = pRes.data;
      if (tRes.data) st.turnos_ativos = tRes.data;
      if (aRes.data) st.alertas = aRes.data;
      setState(st);
    }

    function openCloudModal() {
      const cfg = JSON.parse(localStorage.getItem(CLOUD_CFG_KEY) || '{}');
      document.getElementById('cfgSupabaseUrl').value = cfg.url || '';
      document.getElementById('cfgSupabaseKey').value = cfg.key || '';
      document.getElementById('cloudModal').classList.remove('hidden');
    }
    function closeCloudModal() { document.getElementById('cloudModal').classList.add('hidden'); }
    async function saveCloudConfig() {
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();
      if (!url || !key) return alert('Preencha Project URL e Anon Key.');
      localStorage.setItem(CLOUD_CFG_KEY, JSON.stringify({ url, key }));
      initCloud();
      await pullFromSupabase();
      closeCloudModal();
    }
    function clearCloudConfig() {
      localStorage.removeItem(CLOUD_CFG_KEY);
      initCloud();
      closeCloudModal();
    }

    async function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value.trim().toLowerCase();
      const senha = document.getElementById('loginPassword').value.trim();
      const errEl = document.getElementById('loginError');
      errEl.classList.add('hidden');

      if (supabaseClient) {
        const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password: senha });
        if (error) {
          errEl.textContent = 'Credenciais inválidas: ' + error.message;
          errEl.classList.remove('hidden');
          return;
        }
        const { data: perfil } = await supabaseClient.from('perfis').select('*').eq('id', data.user.id).single();
        if (!perfil || !perfil.ativo) {
          errEl.textContent = 'Usuário sem perfil ativo ou acesso bloqueado pela Central.';
          errEl.classList.remove('hidden');
          return;
        }
        currentUser = perfil;
        await pullFromSupabase();
      } else {
        const st = getState();
        const found = st.users.find(u => u.email.toLowerCase() === email && u.senha === senha);
        if (!found) {
          errEl.textContent = 'Login ou senha incorretos.';
          errEl.classList.remove('hidden');
          return;
        }
        if (!found.ativo) {
          errEl.textContent = 'Acesso suspenso pela Central.';
          errEl.classList.remove('hidden');
          return;
        }
        currentUser = found;
      }

      sessionStorage.setItem(SESSION_KEY, JSON.stringify(currentUser));
      enterAuthenticatedView();
    }

    function enterAuthenticatedView() {
      if (!currentUser) return;
      document.getElementById('loginScreen').classList.add('hidden');

      if (currentUser.role === 'central') {
        document.getElementById('centralScreen').classList.remove('hidden');
        document.getElementById('centralOperatorInfo').textContent = `${currentUser.nome} (${currentUser.matricula})`;
        initMap();
        syncUiAll();
      } else {
        document.getElementById('gvScreen').classList.remove('hidden');
        document.getElementById('gvUserLabel').textContent = `${currentUser.nome} • ${currentUser.matricula}`;
        refreshGps();
        requestWakeLock();
        syncUiAll();
      }
    }

    function restoreSession() {
      const saved = sessionStorage.getItem(SESSION_KEY);
      if (!saved) return;
      try {
        currentUser = JSON.parse(saved);
        if (supabaseClient) pullFromSupabase().then(() => enterAuthenticatedView());
        else enterAuthenticatedView();
      } catch (_) {
        sessionStorage.removeItem(SESSION_KEY);
      }
    }

    function logout() {
      stopSiren();
      sessionStorage.removeItem(SESSION_KEY);
      currentUser = null;
      currentShift = null;
      document.getElementById('gvScreen').classList.add('hidden');
      document.getElementById('centralScreen').classList.add('hidden');
      document.getElementById('loginScreen').classList.remove('hidden');
    }

    function calcDistanceMeters(lat1, lon1, lat2, lon2) {
      const R = 6371e3;
      const toRad = d => d * Math.PI / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function refreshGps() {
      const el = document.getElementById('gvCheckinGpsStatus');
      if (!navigator.geolocation) {
        el.textContent = 'GPS indisponível no navegador (usará coord. do posto)';
        return;
      }
      el.textContent = 'Obtendo coordenadas GPS...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          deviceGps = { lat: Number(pos.coords.latitude.toFixed(6)), lng: Number(pos.coords.longitude.toFixed(6)) };
          el.textContent = `GPS Ativo: ${deviceGps.lat}, ${deviceGps.lng}`;
          renderGvView();
        },
        () => {
          deviceGps = null;
          el.textContent = 'GPS bloqueado (usará coordenadas oficiais do posto)';
        },
        { enableHighAccuracy: true, timeout: 6000 }
      );
    }

    async function assumePosto(postoId) {
      const st = getState();
      const alertBox = document.getElementById('gvCheckinAlert');
      alertBox.classList.add('hidden');

      const posto = st.postos.find(p => p.id === postoId);
      if (!posto || !posto.ativo) return;

      const ocupadoPosto = st.turnos_ativos.find(t => t.posto_id === posto.id && t.agente_id !== currentUser.id);
      if (ocupadoPosto) {
        alertBox.textContent = `BLOQUEADO: O ${posto.nome} já está ocupado por ${ocupadoPosto.agente_nome} (${ocupadoPosto.agente_matricula}).`;
        alertBox.classList.remove('hidden');
        return;
      }

      const targetLat = deviceGps ? deviceGps.lat : posto.lat;
      const targetLng = deviceGps ? deviceGps.lng : posto.lng;

      const ocupadoCoord = st.turnos_ativos.find(t => {
        if (t.agente_id === currentUser.id) return false;
        const mesmaCoordExata = (Number(t.lat).toFixed(5) === Number(targetLat).toFixed(5) && Number(t.lng).toFixed(5) === Number(targetLng).toFixed(5));
        const mesmaCoordPosto = (Number(t.lat).toFixed(5) === Number(posto.lat).toFixed(5) && Number(t.lng).toFixed(5) === Number(posto.lng).toFixed(5));
        const dist = calcDistanceMeters(t.lat, t.lng, targetLat, targetLng);
        return mesmaCoordExata || mesmaCoordPosto || dist < 25;
      });

      if (ocupadoCoord) {
        alertBox.textContent = `BLOQUEADO POR COORDENADA: Já existe um agente (${ocupadoCoord.agente_nome} no ${ocupadoCoord.posto_nome}) operando nestas mesmas coordenadas.`;
        alertBox.classList.remove('hidden');
        return;
      }

      const novoTurno = {
        id: 'turno-' + Date.now(),
        agente_id: currentUser.id,
        agente_nome: currentUser.nome,
        agente_matricula: currentUser.matricula,
        posto_id: posto.id,
        posto_nome: posto.nome,
        lat: targetLat,
        lng: targetLng,
        iniciado_em: new Date().toISOString()
      };

      if (supabaseClient) {
        await supabaseClient.from('turnos_ativos').delete().eq('agente_id', currentUser.id);
        const { error } = await supabaseClient.from('turnos_ativos').insert(novoTurno);
        if (error) {
          alertBox.textContent = 'Conflito simultâneo: Este posto ou coordenada acabou de ser assumido por outro guarda-vidas.';
          alertBox.classList.remove('hidden');
          await pullFromSupabase();
          return;
        }
        await pullFromSupabase();
      } else {
        st.turnos_ativos = st.turnos_ativos.filter(t => t.agente_id !== currentUser.id);
        st.turnos_ativos.push(novoTurno);
        setState(st);
      }
    }

    async function releaseCurrentPosto() {
      if (!currentUser) return;
      if (supabaseClient) {
        await supabaseClient.from('turnos_ativos').delete().eq('agente_id', currentUser.id);
        await pullFromSupabase();
      } else {
        const st = getState();
        st.turnos_ativos = st.turnos_ativos.filter(t => t.agente_id !== currentUser.id);
        setState(st);
      }
    }

    function selectNature(nat) {
      selectedNature = nat;
      document.querySelectorAll('.nature-btn').forEach(btn => {
        btn.classList.toggle('selected', btn.dataset.nature === nat);
      });
    }

    async function triggerSosAlert() {
      if (!currentUser || !currentShift) return;
      const lat = deviceGps ? deviceGps.lat : currentShift.lat;
      const lng = deviceGps ? deviceGps.lng : currentShift.lng;

      const novoAlerta = {
        id: 'sos-' + Date.now(),
        posto_id: currentShift.posto_id,
        posto_nome: currentShift.posto_nome,
        agente_id: currentUser.id,
        agente_nome: `${currentUser.nome} (${currentUser.matricula})`,
        natureza: selectedNature,
        lat,
        lng,
        status: 'ativo',
        criado_em: new Date().toISOString()
      };

      if (navigator.vibrate) navigator.vibrate([300, 100, 300, 100, 500]);

      if (supabaseClient) {
        await supabaseClient.from('alertas').insert(novoAlerta);
        await pullFromSupabase();
      } else {
        const st = getState();
        st.alertas.unshift(novoAlerta);
        setState(st);
      }
    }

    async function cancelOwnAlert(alertId) {
      if (supabaseClient) {
        await supabaseClient.from('alertas').delete().eq('id', alertId);
        await pullFromSupabase();
      } else {
        const st = getState();
        st.alertas = st.alertas.filter(a => a.id !== alertId);
        setState(st);
      }
    }

    function renderGvView() {
      if (!currentUser || currentUser.role !== 'guarda_vidas') return;
      const st = getState();
      currentShift = st.turnos_ativos.find(t => t.agente_id === currentUser.id) || null;

      const checkinEl = document.getElementById('gvCheckinStep');
      const sosEl = document.getElementById('gvSosStep');

      if (!currentShift) {
        checkinEl.classList.remove('hidden');
        sosEl.classList.add('hidden');
        const list = document.getElementById('gvPostoList');
        list.innerHTML = st.postos.map(p => {
          const occ = st.turnos_ativos.find(t => t.posto_id === p.id);
          const coordConflict = !occ && st.turnos_ativos.find(t =>
            Number(t.lat).toFixed(5) === Number(p.lat).toFixed(5) &&
            Number(t.lng).toFixed(5) === Number(p.lng).toFixed(5)
          );
          const disabled = !p.ativo || Boolean(occ) || Boolean(coordConflict);
          let statusTag = '<span class="badge badge-green">Disponível</span>';
          let actionBtn = `<button onclick="assumePosto('${p.id}')" style="padding:8px 14px; background:#0284c7; color:#fff; font-size:12px;">Assumir</button>`;

          if (!p.ativo) {
            statusTag = '<span class="badge badge-gray">Inativo</span>';
            actionBtn = '<span style="font-size:11px; color:#64748b;">Indisponível</span>';
          } else if (occ) {
            statusTag = `<span class="badge badge-red">Ocupado • ${occ.agente_nome}</span>`;
            actionBtn = '<span style="font-size:11px; color:#f87171; font-weight:700;">Bloqueado</span>';
          } else if (coordConflict) {
            statusTag = `<span class="badge badge-amber">Coord. em uso (${coordConflict.posto_nome})</span>`;
            actionBtn = '<span style="font-size:11px; color:#fbbf24; font-weight:700;">Bloqueado</span>';
          }

          return `
            <div class="posto-item ${disabled ? 'locked' : ''}">
              <div>
                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                  <span style="font-size:14px; font-weight:700;">${p.nome}</span>
                  ${statusTag}
                </div>
                <div class="mono" style="font-size:11px; color:#94a3b8; margin-top:4px;">${Number(p.lat).toFixed(5)}, ${Number(p.lng).toFixed(5)}</div>
              </div>
              ${actionBtn}
            </div>
          `;
        }).join('');
      } else {
        checkinEl.classList.add('hidden');
        sosEl.classList.remove('hidden');
        document.getElementById('gvActivePostoName').textContent = currentShift.posto_nome;
        const displayLat = deviceGps ? deviceGps.lat : currentShift.lat;
        const displayLng = deviceGps ? deviceGps.lng : currentShift.lng;
        document.getElementById('gvActiveCoords').textContent = `${displayLat}, ${displayLng}`;

        const myLastAlert = st.alertas.find(a => a.agente_id === currentUser.id && a.status !== 'atendido');
        const banner = document.getElementById('gvStatusBanner');
        if (myLastAlert) {
          banner.classList.remove('hidden');
          if (myLastAlert.status === 'ciente') {
            banner.style.borderColor = '#10b981';
            banner.style.background = 'rgba(6, 78, 59, 0.55)';
            banner.innerHTML = `
              <div style="font-size:12px; font-weight:900; color:#34d399;">✓ CENTRAL CIENTE — APOIO DESPACHADO</div>
              <div style="font-size:12px; margin-top:4px;">A equipe de resgate já recebeu sua localização (${myLastAlert.posto_nome}).</div>
            `;
          } else {
            const elapsedSec = Math.floor((Date.now() - new Date(myLastAlert.criado_em).getTime()) / 1000);
            banner.style.borderColor = '#ef4444';
            banner.style.background = 'rgba(127, 29, 29, 0.65)';
            banner.innerHTML = `
              <div style="font-size:12px; font-weight:900; color:#fca5a5;">🚨 ALERTA SOS TRANSMITIDO!</div>
              <div style="font-size:12px; margin-top:4px;">Aguardando confirmação visual da Central...</div>
              ${elapsedSec <= 8 ? `<button onclick="cancelOwnAlert('${myLastAlert.id}')" class="btn-secondary" style="margin-top:10px;">Cancelar Falso Disparo</button>` : ''}
            `;
          }
        } else {
          banner.classList.add('hidden');
        }
      }
    }

    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) await navigator.wakeLock.request('screen');
      } catch (_) {}
    }

    function unlockAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const btn = document.getElementById('audioUnlockBtn');
      btn.style.background = 'rgba(16, 185, 129, 0.16)';
      btn.style.borderColor = 'rgba(52, 211, 153, 0.45)';
      btn.style.color = '#34d399';
      btn.textContent = '🔊 Sirene Armada';
    }

    function playYelpPulse() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const now = audioCtx.currentTime;

      const osc1 = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      osc1.type = 'sawtooth';
      osc2.type = 'square';

      osc1.frequency.setValueAtTime(850, now);
      osc1.frequency.exponentialRampToValueAtTime(1680, now + 0.16);
      osc1.frequency.exponentialRampToValueAtTime(900, now + 0.32);
      osc1.frequency.exponentialRampToValueAtTime(1720, now + 0.48);
      osc1.frequency.exponentialRampToValueAtTime(850, now + 0.62);

      osc2.frequency.setValueAtTime(858, now);
      osc2.frequency.exponentialRampToValueAtTime(1692, now + 0.16);
      osc2.frequency.exponentialRampToValueAtTime(908, now + 0.32);
      osc2.frequency.exponentialRampToValueAtTime(1735, now + 0.48);
      osc2.frequency.exponentialRampToValueAtTime(858, now + 0.62);

      gain.gain.setValueAtTime(0.45, now);
      gain.gain.setValueAtTime(0.45, now + 0.58);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.63);

      osc1.connect(gain);
      osc2.connect(gain);
      gain.connect(audioCtx.destination);

      osc1.start(now);
      osc2.start(now);
      osc1.stop(now + 0.64);
      osc2.stop(now + 0.64);
    }

    function startSiren() {
      if (sirenInterval) return;
      playYelpPulse();
      sirenInterval = setInterval(playYelpPulse, 640);
    }

    function stopSiren() {
      if (sirenInterval) {
        clearInterval(sirenInterval);
        sirenInterval = null;
      }
    }

    function testSiren() {
      unlockAudio();
      playYelpPulse();
    }

    function switchCentralTab(tabName) {
      ['monitor', 'admin', 'deploy'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`tabBtn-${t}`).classList.remove('active');
      });
      document.getElementById(`tab-${tabName}`).classList.remove('hidden');
      document.getElementById(`tabBtn-${tabName}`).classList.add('active');
      if (tabName === 'monitor' && map) setTimeout(() => map.invalidateSize(), 150);
    }

    function initMap() {
      if (map || typeof L === 'undefined') return;
      map = L.map('map').setView([-8.1150, -34.8920], 13);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        maxZoom: 19
      }).addTo(map);
      mapMarkersLayer = L.layerGroup().addTo(map);

      map.on('click', (e) => {
        document.getElementById('postoLat').value = e.latlng.lat.toFixed(6);
        document.getElementById('postoLng').value = e.latlng.lng.toFixed(6);
      });
    }

    async function acknowledgeAlert(id) {
      if (supabaseClient) {
        await supabaseClient.from('alertas').update({ status: 'ciente', ciente_em: new Date().toISOString() }).eq('id', id);
        await pullFromSupabase();
      } else {
        const st = getState();
        const a = st.alertas.find(x => x.id === id);
        if (a) { a.status = 'ciente'; a.ciente_em = new Date().toISOString(); }
        setState(st);
      }
    }

    async function closeAlert(id) {
      if (supabaseClient) {
        await supabaseClient.from('alertas').update({ status: 'atendido', encerrado_em: new Date().toISOString() }).eq('id', id);
        await pullFromSupabase();
      } else {
        const st = getState();
        const a = st.alertas.find(x => x.id === id);
        if (a) { a.status = 'atendido'; a.encerrado_em = new Date().toISOString(); }
        setState(st);
      }
    }

    async function forceReleaseShift(turnoId) {
      if (supabaseClient) {
        await supabaseClient.from('turnos_ativos').delete().eq('id', turnoId);
        await pullFromSupabase();
      } else {
        const st = getState();
        st.turnos_ativos = st.turnos_ativos.filter(t => t.id !== turnoId);
        setState(st);
      }
    }

    async function handleCreateUser(e) {
      e.preventDefault();
      const nome = document.getElementById('newUserName').value.trim();
      const matricula = document.getElementById('newUserBadge').value.trim().toUpperCase();
      const email = document.getElementById('newUserEmail').value.trim().toLowerCase();
      const senha = document.getElementById('newUserPass').value.trim();
      const role = document.getElementById('newUserRole').value;

      if (supabaseClient && supabaseAdminAux) {
        const { data, error } = await supabaseAdminAux.auth.signUp({ email, password: senha });
        if (error) return alert('Erro ao criar login: ' + error.message);
        await supabaseClient.from('perfis').insert({
          id: data.user.id, nome, matricula, email, role, ativo: true
        });
        await pullFromSupabase();
      } else {
        const st = getState();
        if (st.users.some(u => u.email === email || u.matricula === matricula)) {
          return alert('Já existe uma pessoa cadastrada com este e-mail ou matrícula.');
        }
        st.users.push({
          id: 'u-' + Date.now(), nome, matricula, email, senha, role, ativo: true
        });
        setState(st);
      }
      e.target.reset();
    }

    async function toggleUserStatus(userId) {
      if (userId === currentUser.id) return alert('Você não pode bloquear seu próprio acesso.');
      const st = getState();
      const u = st.users.find(x => x.id === userId);
      if (!u) return;
      if (supabaseClient) {
        await supabaseClient.from('perfis').update({ ativo: !u.ativo }).eq('id', userId);
        await pullFromSupabase();
      } else {
        u.ativo = !u.ativo;
        if (!u.ativo) st.turnos_ativos = st.turnos_ativos.filter(t => t.agente_id !== userId);
        setState(st);
      }
    }

    async function changeUserPassword(userId) {
      if (supabaseClient) return alert('No servidor Supabase, altere a senha pelo painel Authentication > Users.');
      const nova = prompt('Digite a nova senha (mínimo 6 caracteres):');
      if (!nova || nova.trim().length < 6) return;
      const st = getState();
      const u = st.users.find(x => x.id === userId);
      if (u) { u.senha = nova.trim(); setState(st); }
    }

    async function handleSavePosto(e) {
      e.preventDefault();
      const editId = document.getElementById('editPostoId').value;
      const nome = document.getElementById('postoName').value.trim();
      const lat = Number(document.getElementById('postoLat').value);
      const lng = Number(document.getElementById('postoLng').value);

      const st = getState();
      const dupCoord = st.postos.find(p =>
        p.id !== editId &&
        Number(p.lat).toFixed(5) === lat.toFixed(5) &&
        Number(p.lng).toFixed(5) === lng.toFixed(5)
      );
      if (dupCoord) {
        return alert(`Coordenadas já cadastradas no "${dupCoord.nome}". Cada posto precisa de coordenadas exclusivas.`);
      }

      if (supabaseClient) {
        if (editId) {
          await supabaseClient.from('postos').update({ nome, lat, lng }).eq('id', editId);
        } else {
          await supabaseClient.from('postos').insert({ nome, lat, lng, ativo: true });
        }
        await pullFromSupabase();
      } else {
        if (editId) {
          const p = st.postos.find(x => x.id === editId);
          if (p) { p.nome = nome; p.lat = lat; p.lng = lng; }
        } else {
          st.postos.push({ id: 'p-' + Date.now(), nome, lat, lng, ativo: true });
        }
        setState(st);
      }
      resetPostoForm();
    }

    function editPosto(id) {
      const p = getState().postos.find(x => x.id === id);
      if (!p) return;
      document.getElementById('editPostoId').value = p.id;
      document.getElementById('postoName').value = p.nome;
      document.getElementById('postoLat').value = p.lat;
      document.getElementById('postoLng').value = p.lng;
      document.getElementById('savePostoBtn').textContent = 'Atualizar Posto';
    }

    function resetPostoForm() {
      document.getElementById('editPostoId').value = '';
      document.getElementById('postoName').value = '';
      document.getElementById('postoLat').value = '';
      document.getElementById('postoLng').value = '';
      document.getElementById('savePostoBtn').textContent = 'Salvar Posto';
    }

    async function togglePostoActive(id) {
      const st = getState();
      const p = st.postos.find(x => x.id === id);
      if (!p) return;
      if (supabaseClient) {
        await supabaseClient.from('postos').update({ ativo: !p.ativo }).eq('id', id);
        await pullFromSupabase();
      } else {
        p.ativo = !p.ativo;
        if (!p.ativo) st.turnos_ativos = st.turnos_ativos.filter(t => t.posto_id !== id);
        setState(st);
      }
    }

    function exportAlertsCsv() {
      const st = getState();
      const rows = [['ID', 'Posto', 'Agente', 'Natureza', 'Latitude', 'Longitude', 'Status', 'Criado Em', 'Encerrado Em']];
      st.alertas.forEach(a => {
        rows.push([a.id, a.posto_nome, a.agente_nome, a.natureza, a.lat, a.lng, a.status, a.criado_em, a.encerrado_em || '']);
      });
      const csv = rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `olho_no_mar_ocorrencias_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    }

    function copyCode(id) {
      navigator.clipboard.writeText(document.getElementById(id).textContent);
      alert('Código copiado!');
    }

    function renderCentralView() {
      if (!currentUser || currentUser.role !== 'central') return;
      const st = getState();

      const unackedAlerts = st.alertas.filter(a => a.status === 'ativo');
      const openAlerts = st.alertas.filter(a => a.status !== 'atendido');
      const closedAlerts = st.alertas.filter(a => a.status === 'atendido');

      if (unackedAlerts.length > 0) startSiren();
      else stopSiren();

      document.getElementById('activeAlertCount').textContent = openAlerts.length;
      document.getElementById('activeShiftCount').textContent = st.turnos_ativos.length;

      const activeList = document.getElementById('activeAlertsList');
      if (openAlerts.length === 0) {
        activeList.innerHTML = '<p style="font-size:12px; color:#64748b; text-align:center; padding:12px;">Nenhuma ocorrência ativa na orla.</p>';
      } else {
        activeList.innerHTML = openAlerts.map(a => {
          const hora = new Date(a.criado_em).toLocaleTimeString('pt-BR');
          const isUnacked = a.status === 'ativo';
          return `
            <div class="alert-card ${isUnacked ? '' : 'ciente'}">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                <div>
                  <span class="badge ${isUnacked ? 'badge-red' : 'badge-amber'}">${isUnacked ? '🚨 NOVO SOS' : '✓ CENTRAL CIENTE'}</span>
                  <div style="font-size:14px; font-weight:900; margin-top:6px;">${a.posto_nome}</div>
                  <div style="font-size:12px; color:#e2e8f0; font-weight:600;">${a.natureza}</div>
                  <div style="font-size:11px; color:#94a3b8; margin-top:2px;">Agente: ${a.agente_nome} • ${hora}</div>
                  <div class="mono" style="font-size:11px; color:#7dd3fc; margin-top:2px;">${Number(a.lat).toFixed(5)}, ${Number(a.lng).toFixed(5)}</div>
                </div>
                <button onclick="map && map.flyTo([${a.lat}, ${a.lng}], 17)" class="btn-secondary">Focar</button>
              </div>
              <div style="display:flex; gap:8px; margin-top:12px;">
                ${isUnacked ? `<button onclick="acknowledgeAlert('${a.id}')" style="flex:1; padding:8px; background:#f59e0b; color:#020617; font-size:11px; font-weight:900;">Confirmar (ACK)</button>` : ''}
                <button onclick="closeAlert('${a.id}')" style="flex:1; padding:8px; background:#059669; color:#fff; font-size:11px;">Encerrar Ocorrência</button>
              </div>
            </div>
          `;
        }).join('');
      }

      const shiftList = document.getElementById('activeShiftsList');
      if (st.turnos_ativos.length === 0) {
        shiftList.innerHTML = '<p style="font-size:12px; color:#64748b;">Nenhum agente realizou check-in em posto.</p>';
      } else {
        shiftList.innerHTML = st.turnos_ativos.map(t => `
          <div class="posto-item">
            <div>
              <div style="font-size:12px; font-weight:700;">${t.posto_nome} — <span style="color:#34d399;">${t.agente_nome}</span></div>
              <div class="mono" style="font-size:10px; color:#94a3b8;">${t.agente_matricula} • ${Number(t.lat).toFixed(5)}, ${Number(t.lng).toFixed(5)}</div>
            </div>
            <button onclick="forceReleaseShift('${t.id}')" class="btn-secondary">Liberar</button>
          </div>
        `).join('');
      }

      const histList = document.getElementById('historyAlertsList');
      histList.innerHTML = closedAlerts.slice(0, 10).map(a => `
        <div class="posto-item" style="opacity:0.8;">
          <div>
            <div style="font-size:12px; font-weight:700;">${a.posto_nome} • ${a.natureza}</div>
            <div style="font-size:11px; color:#94a3b8;">${a.agente_nome}</div>
          </div>
          <span class="badge badge-green">Atendido</span>
        </div>
      `).join('') || '<p style="font-size:12px; color:#64748b;">Sem registros anteriores.</p>';

      document.getElementById('usersTableList').innerHTML = st.users.map(u => `
        <div class="posto-item">
          <div>
            <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
              <span style="font-size:12px; font-weight:700;">${u.nome}</span>
              <span class="badge badge-gray mono">${u.matricula}</span>
              <span class="badge ${u.role === 'central' ? 'badge-amber' : 'badge-green'}">${u.role === 'central' ? 'Central' : 'Guarda-Vidas'}</span>
            </div>
            <div style="font-size:11px; color:#94a3b8; margin-top:4px;">Login: ${u.email} • Senha: <span class="mono">${u.senha}</span></div>
          </div>
          <div style="display:flex; gap:6px;">
            <button onclick="changeUserPassword('${u.id}')" class="btn-secondary">Senha</button>
            <button onclick="toggleUserStatus('${u.id}')" class="btn-secondary" style="color:${u.ativo ? '#34d399' : '#f87171'};">
              ${u.ativo ? 'Ativo' : 'Bloq.'}
            </button>
          </div>
        </div>
      `).join('');

      document.getElementById('postosAdminList').innerHTML = st.postos.map(p => {
        const occ = st.turnos_ativos.find(t => t.posto_id === p.id);
        return `
          <div class="posto-item">
            <div>
              <div style="font-size:12px; font-weight:700;">${p.nome} ${occ ? `<span style="color:#34d399;">(${occ.agente_nome})</span>` : ''}</div>
              <div class="mono" style="font-size:11px; color:#94a3b8;">${Number(p.lat).toFixed(5)}, ${Number(p.lng).toFixed(5)}</div>
            </div>
            <div style="display:flex; gap:6px;">
              <button onclick="editPosto('${p.id}')" class="btn-secondary" style="color:#38bdf8;">Editar</button>
              <button onclick="togglePostoActive('${p.id}')" class="btn-secondary" style="color:${p.ativo ? '#34d399' : '#94a3b8'};">
                ${p.ativo ? 'Ativo' : 'Inativo'}
              </button>
            </div>
          </div>
        `;
      }).join('');

      if (map && mapMarkersLayer && typeof L !== 'undefined') {
        mapMarkersLayer.clearLayers();
        st.postos.forEach(p => {
          const occ = st.turnos_ativos.find(t => t.posto_id === p.id);
          const cls = !p.ativo ? 'posto-marker inactive' : (occ ? 'posto-marker occupied' : 'posto-marker');
          const icon = L.divIcon({ className: '', html: `<div class="${cls}"></div>`, iconSize: [16, 16] });
          const m = L.marker([p.lat, p.lng], { icon, draggable: true }).addTo(mapMarkersLayer);
          m.bindPopup(`<b>${p.nome}</b><br>${occ ? 'Ocupado: ' + occ.agente_nome : 'Posto Livre'}`);
          m.on('dragend', async (ev) => {
            const pos = ev.target.getLatLng();
            if (supabaseClient) {
              await supabaseClient.from('postos').update({ lat: Number(pos.lat.toFixed(6)), lng: Number(pos.lng.toFixed(6)) }).eq('id', p.id);
              await pullFromSupabase();
            } else {
              const s = getState();
              const item = s.postos.find(x => x.id === p.id);
              if (item) { item.lat = Number(pos.lat.toFixed(6)); item.lng = Number(pos.lng.toFixed(6)); }
              setState(s);
            }
          });
        });

        openAlerts.forEach(a => {
          const sosIcon = L.divIcon({ className: 'sos-marker', html: '<div class="marker-ping"></div>', iconSize: [22, 22] });
          L.marker([a.lat, a.lng], { icon: sosIcon })
            .addTo(mapMarkersLayer)
            .bindPopup(`<b style="color:#ef4444">🚨 SOS — ${a.posto_nome}</b><br>${a.natureza}<br>Agente: ${a.agente_nome}`)
            .openPopup();
        });
      }
    }

    function syncUiAll() {
      renderGvView();
      renderCentralView();
    }

    initCloud();
    restoreSession();
  </script>
</body>
</html>
