create table if not exists perfis (
  id uuid primary key references auth.users(id) on delete cascade,
  nome text not null,
  matricula text not null unique,
  email text not null unique,
  role text not null check (role in ('central', 'guarda_vidas')),
  ativo boolean default true,
  criado_em timestamptz default now()
);

create table if not exists postos (
  id uuid primary key default gen_random_uuid(),
  nome text not null unique,
  lat double precision not null,
  lng double precision not null,
  ativo boolean default true,
  constraint postos_coordenadas_unicas unique (lat, lng)
);

-- Trava exclusiva: impede 2 agentes no mesmo posto ou nas mesmas coordenadas
create table if not exists turnos_ativos (
  id uuid primary key default gen_random_uuid(),
  agente_id uuid not null unique references perfis(id) on delete cascade,
  agente_nome text not null,
  agente_matricula text not null,
  posto_id uuid not null unique references postos(id) on delete cascade,
  posto_nome text not null,
  lat double precision not null,
  lng double precision not null,
  iniciado_em timestamptz default now(),
  constraint turnos_coordenadas_unicas unique (lat, lng)
);

create table if not exists alertas (
  id uuid primary key default gen_random_uuid(),
  posto_id uuid references postos(id),
  posto_nome text not null,
  agente_id uuid references perfis(id),
  agente_nome text not null,
  natureza text default 'Afogamento / Resgate',
  lat double precision not null,
  lng double precision not null,
  status text not null default 'ativo' check (status in ('ativo', 'ciente', 'atendido')),
  criado_em timestamptz default now(),
  ciente_em timestamptz,
  encerrado_em timestamptz
);

alter publication supabase_realtime add table postos, turnos_ativos, alertas;</pre>
